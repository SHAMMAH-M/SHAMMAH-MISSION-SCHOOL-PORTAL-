<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>School Settings - Shammah Mission School</title>

<style>
body{
font-family:Arial,sans-serif;
margin:0;
background:#f1f8f4;
color:#173b2a;
}

header{
background:#087f3f;
color:white;
text-align:center;
padding:20px;
}

main{
max-width:900px;
margin:auto;
padding:15px;
}

.card{
background:white;
padding:20px;
margin-bottom:18px;
border-radius:10px;
box-shadow:0 2px 8px #0002;
}

label{
font-weight:bold;
display:block;
margin-top:12px;
}

input,select{
width:100%;
padding:11px;
margin-top:6px;
border:1px solid #aaa;
border-radius:6px;
box-sizing:border-box;
}

button{
padding:12px 18px;
border:0;
border-radius:6px;
background:#087f3f;
color:white;
margin-top:15px;
cursor:pointer;
}

.danger{
background:#b42318;
}

.success{
background:#1769aa;
}

.grades{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
}

@media(max-width:700px){
.grades{
grid-template-columns:1fr 1fr;
}
}
</style>
</head>

<body>

<header>
<h1>SHAMMAH MISSION SCHOOL</h1>
<p>Director School Settings</p>
</header>

<main>

<div class="card">

<h2>School Information</h2>

<label>School Name</label>
<input id="schoolName">

<label>School UPI</label>
<input id="upi" placeholder="Enter school UPI">

<label>School Location</label>
<input id="location">

<label>School Email</label>
<input id="email">

<label>School Phone</label>
<input id="phone">

<button onclick="saveSchool()">
SAVE SCHOOL INFORMATION
</button>

</div>


<div class="card">

<h2>Academic Settings</h2>

<label>Academic Year</label>
<input id="year" type="number">

<label>Current Term</label>

<select id="term">
<option>Term 1</option>
<option>Term 2</option>
<option>Term 3</option>
</select>

<label>Opening Date</label>
<input id="openingDate" type="date">

<label>Closing Date</label>
<input id="closingDate" type="date">

<button onclick="saveAcademic()">
SAVE ACADEMIC SETTINGS
</button>

</div>


<div class="card">

<h2>Grading Settings</h2>

<p>
The Director can change the boundaries used by the portal.
</p>

<div class="grades">

<div>
<label>EE Minimum</label>
<input id="ee" type="number">
</div>

<div>
<label>ME Minimum</label>
<input id="me" type="number">
</div>

<div>
<label>AE Minimum</label>
<input id="ae" type="number">
</div>

<div>
<label>BE Minimum</label>
<input id="be" type="number">
</div>

</div>

<button onclick="saveGrading()">
SAVE GRADING
</button>

</div>


<div class="card">

<h2>Report Card Settings</h2>

<label>Class Teacher Remark Heading</label>
<input id="classRemark"
value="Class Teacher's Remark">

<label>Head Teacher Remark Heading</label>
<input id="headRemark"
value="Head Teacher's Remark">

<label>Report Card Footer</label>
<input id="footer"
value="Generated by Mwalimu Andrew Kimutai">

<button onclick="saveReportSettings()">
SAVE REPORT SETTINGS
</button>

</div>


<div class="card">

<h2>Portal Information</h2>

<p>
<strong>System:</strong>
SHAMMAH MISSION SCHOOL PORTAL
</p>

<p>
<strong>Classes:</strong>
Grade 7, Grade 8 and Grade 9
</p>

<p>
<strong>Terms:</strong>
Term 1, Term 2 and Term 3
</p>

<button class="success" onclick="exportData()">
BACKUP SCHOOL DATA
</button>

</div>

</main>


<script>

const KEY="SHAMMAH_MISSION_SCHOOL_DATABASE";

let db=JSON.parse(localStorage.getItem(KEY))||{};

if(!db.school)db.school={};

if(!db.academic)db.academic={};

if(!db.grading)db.grading={};

if(!db.reportSettings)db.reportSettings={};


/* LOAD SETTINGS */

function load(){

document.getElementById("schoolName").value=
db.school.name||"SHAMMAH MISSION SCHOOL";

document.getElementById("upi").value=
db.school.upi||"";

document.getElementById("location").value=
db.school.location||"Marakwet West, Kapsowar";

document.getElementById("email").value=
db.school.email||"aicshammahschool2025@gmail.com";

document.getElementById("phone").value=
db.school.phone||"";


document.getElementById("year").value=
db.academic.year||2026;

document.getElementById("term").value=
db.academic.term||"Term 1";

document.getElementById("openingDate").value=
db.academic.openingDate||"";

document.getElementById("closingDate").value=
db.academic.closingDate||"";


document.getElementById("ee").value=
db.grading.ee!==undefined?db.grading.ee:90;

document.getElementById("me").value=
db.grading.me!==undefined?db.grading.me:50;

document.getElementById("ae").value=
db.grading.ae!==undefined?db.grading.ae:30;

document.getElementById("be").value=
db.grading.be!==undefined?db.grading.be:0;


document.getElementById("classRemark").value=
db.reportSettings.classRemark||
"Class Teacher's Remark";

document.getElementById("headRemark").value=
db.reportSettings.headRemark||
"Head Teacher's Remark";

document.getElementById("footer").value=
db.reportSettings.footer||
"Generated by Mwalimu Andrew Kimutai";

}


/* SAVE SCHOOL */

function saveSchool(){

db.school.name=
document.getElementById("schoolName").value;

db.school.upi=
document.getElementById("upi").value;

db.school.location=
document.getElementById("location").value;

db.school.email=
document.getElementById("email").value;

db.school.phone=
document.getElementById("phone").value;

save();

alert("School information saved.");

}


/* SAVE ACADEMIC */

function saveAcademic(){

db.academic.year=
document.getElementById("year").value;

db.academic.term=
document.getElementById("term").value;

db.academic.openingDate=
document.getElementById("openingDate").value;

db.academic.closingDate=
document.getElementById("closingDate").value;

save();

alert("Academic settings saved.");

}


/* SAVE GRADING */

function saveGrading(){

db.grading.ee=
Number(document.getElementById("ee").value);

db.grading.me=
Number(document.getElementById("me").value);

db.grading.ae=
Number(document.getElementById("ae").value);

db.grading.be=
Number(document.getElementById("be").value);

save();

alert("Grading settings saved.");

}


/* SAVE REPORT SETTINGS */

function saveReportSettings(){

db.reportSettings.classRemark=
document.getElementById("classRemark").value;

db.reportSettings.headRemark=
document.getElementById("headRemark").value;

db.reportSettings.footer=
document.getElementById("footer").value;

save();

alert("Report-card settings saved.");

}


/* DATABASE SAVE */

function save(){

localStorage.setItem(
KEY,
JSON.stringify(db)
);

}


/* BACKUP */

function exportData(){

let data=JSON.stringify(db,null,2);

let blob=new Blob(
[data],
{type:"application/json"}
);

let url=URL.createObjectURL(blob);

let a=document.createElement("a");

a.href=url;

a.download=
"shammah-school-backup.json";

a.click();

URL.revokeObjectURL(url);

}

load();

</script>

</body>
</html>
